<div class="layout-wrapper">
    <div class="header d-flex justify-content-between align-items-center">
        <div class="menu-toggle-btn">
            <a href="#">
                <i class="bi bi-list" style="color: #dbb778; margin-left: 10px"></i>
            </a>
        </div>
        <div class="header-title">
            <span>Manage Users</span>
        </div>
        <a href="/" class="logo">
            <img src="/assets/User/logo/Logo-min.png" height="40" id="logo" alt="logo" />
        </a>
        <div class="header-mobile-buttons d-flex align-items-center">
            <a href="#" class="search-bar-btn"></a>
            <a href="#" class="actions-btn"><i class="bi bi-three-dots"></i></a>
        </div>
    </div>

    <div class="content">
        <div class="mb-4">
            <nav style="--bs-breadcrumb-divider: '>'" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-globe2 small me-2"></i>
                            Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Users</li>
                </ol>
            </nav>

            <br />

            <% if (success && success.length) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
                    <% if (error && error.length) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= error[0] %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                        <% } %>
        </div>

        <div class="table-responsive">
            <table class="table table-custom table-lg mb-0" id="usersTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Joined Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users && users.length> 0) { %>
                        <% users.forEach(user=> { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-sm me-3">
                                            <span class="avatar-text rounded-circle bg-primary text-white">
                                                <%= user.name.charAt(0).toUpperCase() %>
                                            </span>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">
                                                <%= user.name %>
                                            </h6>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <%= user.email %>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        <%= user.role %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-<%= user.approved ? 'success' : 'warning' %>">
                                        <%= user.approved ? 'Active' : 'Pending' %>
                                    </span>
                                </td>
                                <td>
                                    <%= new Date(user.createdAt).toLocaleDateString() %>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex">
                                        <div class="dropdown ms-auto">
                                            <a href="#" data-bs-toggle="dropdown" class="btn btn-floating"
                                                aria-haspopup="true" aria-expanded="false">
                                                <i class="bi bi-three-dots"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <a href="/users/<%= user.id %>/edit" class="dropdown-item">Edit</a>

                                                <form action="/users/<%= user.id %>/toggle" method="POST"
                                                    style="display: inline">
                                                    <button type="submit" class="dropdown-item">
                                                        <%= user.approved ? 'Deactivate' : 'Activate' %>
                                                    </button>
                                                </form>

                                                <form action="/users/delete/<%= user.id %>" method="POST"
                                                    style="display: inline"
                                                    onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                    <button type="submit"
                                                        class="dropdown-item text-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <div class="text-muted">No users found</div>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <footer>
            <p class="text-center my-2">&copy; 2024 Opti-Reserve</p>
        </footer>
    </div>
</div>