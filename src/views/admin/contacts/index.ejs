<div class="layout-wrapper">
    <!-- Header -->
    <div class="header d-flex justify-content-between align-items-center">
        <div class="menu-toggle-btn">
            <a href="#">
                <i class="bi bi-list" style="color: #dbb778; margin-left: 10px"></i>
            </a>
        </div>

        <div class="header-title">
            <span>Contact Messages</span>
        </div>

        <a href="/" class="logo">
            <img src="/assets/User/logo/Logo-min.png" height="40" id="logo" alt="logo" />
        </a>

        <div class="header-mobile-buttons d-flex align-items-center">
            <a href="#" class="search-bar-btn"></a>
            <a href="#" class="actions-btn">
                <i class="bi bi-three-dots"></i>
            </a>
        </div>
    </div>

    <!-- Content -->
    <div class="content">
        <!-- Breadcrumb -->
        <div class="mb-4">
            <nav style="--bs-breadcrumb-divider: '>'" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/dashboard">
                            <i class="bi bi-globe2 small me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Contacts</li>
                </ol>
            </nav>

            <br />

            <% if (success && success.length) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
                    <% if (error && error.length) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= error[0] %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                        <% } %>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-custom table-lg mb-0" id="contactsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>NAME</th>
                        <th>EMAIL</th>
                        <th>PHONE</th>
                        <th>MESSAGE</th>
                        <th>PREF.</th>
                        <th>DATE</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (contacts && contacts.length> 0) { %> <% contacts.forEach(contact=> { %>
                            <tr>
                                <td>
                                    <%= contact.id %>
                                </td>
                                <td>
                                    <%= contact.firstName %>
                                        <%= contact.lastName %>
                                </td>
                                <td>
                                    <%= contact.email %>
                                </td>
                                <td>
                                    <%= contact.phone %>
                                </td>
                                <td>
                                    <span title="<%= contact.comments %>">
                                        <%= contact.comments.length> 50 ? contact.comments.substring(0, 50) + '...' :
                                            contact.comments %>
                                    </span>
                                </td>
                                <td>
                                    <%= contact.informBy || '-' %>
                                </td>
                                <td>
                                    <%= new Date(contact.createdAt).toLocaleDateString() %>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex">
                                        <div class="dropdown ms-auto">
                                            <a href="#" data-bs-toggle="dropdown" class="btn btn-floating"
                                                aria-haspopup="true" aria-expanded="false">
                                                <i class="bi bi-three-dots"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <a href="/contacts/<%= contact.id %>" class="dropdown-item">View</a>
                                                <form action="/contacts/delete/<%= contact.id %>" method="POST"
                                                    style="display: inline">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">
                                            No messages found.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <footer>
            <p class="text-center my-2">&copy; 2024 Opti-Reserve</p>
        </footer>
        <br />
    </div>
</div>