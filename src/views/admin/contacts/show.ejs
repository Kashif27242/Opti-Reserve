<div class="layout-wrapper">
    <!-- Header -->
    <div class="header d-flex justify-content-between align-items-center">
        <div class="menu-toggle-btn">
            <a href="#">
                <i class="bi bi-list" style="color: #dbb778; margin-left: 10px"></i>
            </a>
        </div>

        <div class="header-title">
            <span>Contact Details</span>
        </div>

        <a href="/" class="logo">
            <img src="/assets/User/logo/Logo-min.png" height="40" id="logo" alt="logo" />
        </a>

        <div class="header-mobile-buttons d-flex align-items-center">
            <a href="#" class="search-bar-btn"></a>
            <a href="#" class="actions-btn">
                <i class="bi bi-three-dots"></i>
            </a>
        </div>
    </div>

    <!-- Content -->
    <div class="content">
        <!-- Breadcrumb -->
        <div class="mb-4">
            <nav style="--bs-breadcrumb-divider: '>'" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/dashboard">
                            <i class="bi bi-globe2 small me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/contacts">Contacts</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card" style="background-color: #1e1e1e; border: 1px solid #333;">
                    <div class="card-header d-flex justify-content-between align-items-center"
                        style="background-color: #252525; border-bottom: 1px solid #333;">
                        <h5 class="mb-0 text-white">Message from <%= contact.firstName %>
                                <%= contact.lastName %>
                        </h5>
                        <span class="text-muted small">
                            <%= new Date(contact.createdAt).toLocaleString() %>
                        </span>
                    </div>
                    <div class="card-body text-white">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <strong style="color: #dbb778;">Email:</strong>
                                <p class="mt-1"><a href="mailto:<%= contact.email %>"
                                        class="text-decoration-none text-light">
                                        <%= contact.email %>
                                    </a></p>
                            </div>
                            <div class="col-md-6">
                                <strong style="color: #dbb778;">Phone:</strong>
                                <p class="mt-1"><a href="tel:<%= contact.phone %>"
                                        class="text-decoration-none text-light">
                                        <%= contact.phone %>
                                    </a></p>
                            </div>
                        </div>

                        <div class="mb-4">
                            <strong style="color: #dbb778;">Preferred Contact Method:</strong>
                            <p class="mt-1"><span class="badge" style="background-color: #dbb778; color: black;">
                                    <%= contact.informBy || 'Not specified' %>
                                </span></p>
                        </div>

                        <div class="mb-4">
                            <strong style="color: #dbb778;">Message:</strong>
                            <div class="p-3 rounded mt-2"
                                style="background-color: #252525; border: 1px solid #333; white-space: pre-wrap; color: #e0e0e0;">
                                <%= contact.comments %>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/contacts" class="btn btn-outline-light">Back to List</a>
                            <form action="/contacts/delete/<%= contact.id %>" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this message?');">
                                <button type="submit" class="btn btn-danger">Delete Message</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <p class="text-center my-2">&copy; 2024 Opti-Reserve</p>
        </footer>
        <br />
    </div>
</div>