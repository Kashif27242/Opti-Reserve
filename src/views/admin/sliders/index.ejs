<div class="layout-wrapper">
    <div class="header d-flex justify-content-between align-items-center">
        <div class="menu-toggle-btn">
            <a href="#">
                <i class="bi bi-list" style="color: #dbb778; margin-left: 10px"></i>
            </a>
        </div>
        <div class="header-title">
            <span>Manage Slider</span>
        </div>
        <a href="/" class="logo">
            <img src="/assets/User/logo/Logo-min.png" height="40" id="logo" alt="logo" />
        </a>
        <div class="header-mobile-buttons d-flex align-items-center">
            <a href="#" class="search-bar-btn"></a>
            <a href="#" class="actions-btn"><i class="bi bi-three-dots"></i></a>
        </div>
    </div>

    <div class="content">
        <div class="mb-4">
            <nav style="--bs-breadcrumb-divider: '>'" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-globe2 small me-2"></i>
                            Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Slider</li>
                </ol>
            </nav>

            <div>
                <a href="/sliders/create">
                    <button class="btn btn-primary">Add Slider Image</button>
                </a>
            </div>

            <br />

            <% if (success && success.length) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
                    <% if (error && error.length) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= error[0] %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                        <% } %>
        </div>

        <div class="table-responsive">
            <table class="table table-custom table-lg mb-0" id="slidersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>IMAGE</th>
                        <th>TITLE</th>
                        <th>STATUS</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (sliders && sliders.length> 0) { %>
                        <% sliders.forEach(slider=> { %>
                            <tr>
                                <td>
                                    <%= slider.id %>
                                </td>
                                <td>
                                    <% if (slider.image.startsWith('http')) { %>
                                        <img src="<%= slider.image %>" alt="Slider Image"
                                            style="width: 100px; height: 60px; object-fit: cover; border-radius: 5px;">
                                        <% } else { %>
                                            <img src="/uploads/sliders/<%= slider.image %>" alt="Slider Image"
                                                style="width: 100px; height: 60px; object-fit: cover; border-radius: 5px;">
                                            <% } %>
                                </td>
                                <td>
                                    <%= slider.title || '-' %>
                                </td>
                                <td>
                                    <span class="badge bg-<%= slider.active ? 'success' : 'secondary' %>">
                                        <%= slider.active ? 'Active' : 'Inactive' %>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex">
                                        <div class="dropdown ms-auto">
                                            <a href="#" data-bs-toggle="dropdown" class="btn btn-floating"
                                                aria-haspopup="true" aria-expanded="false">
                                                <i class="bi bi-three-dots"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <form action="/sliders/<%= slider.id %>/toggle" method="POST"
                                                    style="display: inline">
                                                    <button type="submit" class="dropdown-item">
                                                        <%= slider.active ? 'Deactivate' : 'Activate' %>
                                                    </button>
                                                </form>
                                                <form action="/sliders/delete/<%= slider.id %>" method="POST"
                                                    style="display: inline" onsubmit="return confirm('Are you sure?');">
                                                    <button type="submit"
                                                        class="dropdown-item text-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No slider images found.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <footer>
            <p class="text-center my-2">&copy; 2024 Opti-Reserve</p>
        </footer>
    </div>
</div>