<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>Opti-Reserve - Forgot Password</title>

  <!-- Favicon -->
  <link rel="shortcut icon" href="/assets/admin/assets/images/favicon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Main Bootstrap style file -->
  <link rel="stylesheet" href="/assets/admin/dist/css/app.min.css" type="text/css" />

  <style>
    :root {
      --color-bg-dark: #0f172a;
      --color-bg-darker: #020617;
      --color-accent: #00bfff;
      --color-accent-hover: #06b6d4;
      --color-accent-gold: #DBB778;
      
      --glass-bg: rgba(15, 23, 42, 0.55);
      --glass-border: rgba(255, 255, 255, 0.08);
      --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--color-bg-darker) !important;
      background-image: radial-gradient(circle at top center, #1e293b 0%, #020617 100%) !important;
      color: #f8fafc !important;
      min-height: 100vh;
      margin: 0;
    }

    .auth .form-wrapper {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      max-width: 480px !important;
      margin: auto !important;
      min-height: 100vh !important;
      padding: 40px 20px !important;
    }

    .glass-panel {
      background: var(--glass-bg) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border) !important;
      box-shadow: var(--glass-shadow) !important;
      border-radius: 20px !important;
      width: 100% !important;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Outfit', sans-serif;
    }

    /* Custom form elements styled dark/glass */
    .form-control {
      background-color: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      color: #fff !important;
      border-radius: 10px !important;
      padding: 12px 16px !important;
      transition: all 0.2s ease !important;
    }

    .form-control:focus {
      background-color: rgba(255, 255, 255, 0.08) !important;
      border-color: var(--color-accent) !important;
      box-shadow: 0 0 15px rgba(0, 191, 255, 0.25) !important;
    }

    .form-control::placeholder {
      color: rgba(255, 255, 255, 0.35) !important;
    }

    .form-label {
      font-weight: 600;
      color: #94a3b8;
      font-size: 13px;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Input type date styling adjustment */
    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(1) sepia(50%) saturate(1000%) hue-rotate(180deg);
      cursor: pointer;
    }

    /* Primary button style */
    .btn-primary {
      background-color: var(--color-accent) !important;
      border-color: var(--color-accent) !important;
      color: #020617 !important;
      font-weight: 700 !important;
      padding: 12px 20px !important;
      border-radius: 10px !important;
      width: 100%;
      transition: all 0.2s ease !important;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 14px;
    }

    .btn-primary:hover, .btn-primary:focus {
      background-color: var(--color-accent-hover) !important;
      border-color: var(--color-accent-hover) !important;
      box-shadow: 0 0 20px rgba(0, 191, 255, 0.4) !important;
      transform: translateY(-2px);
    }

    .auth-link {
      color: var(--color-accent) !important;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .auth-link:hover {
      color: var(--color-accent-hover) !important;
      text-decoration: underline !important;
    }

    .alert-danger {
      background-color: rgba(239, 68, 68, 0.15) !important;
      border: 1px solid rgba(239, 68, 68, 0.3) !important;
      color: #f87171 !important;
      border-radius: 10px !important;
    }

    .alert-success {
      background-color: rgba(16, 185, 129, 0.15) !important;
      border: 1px solid rgba(16, 185, 129, 0.3) !important;
      color: #34d399 !important;
      border-radius: 10px !important;
    }
  </style>
</head>

<body class="auth">
  <div class="form-wrapper">
    <div class="text-uppercase text-center mb-4" style="font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 24px; color: #DBB778; letter-spacing: 2px;">
      Welcome to Opti-Reserve
    </div>

    <div class="card glass-panel p-4 p-md-5 border-0 shadow-lg">
      <div class="d-flex justify-content-center mb-4">
        <h1 id="main_logo" style="
              font-family: 'Outfit', sans-serif;
              font-weight: 700;
              font-size: 2.5rem;
              color: white;
              text-shadow: 2px 2px 10px rgba(0, 153, 255, 0.5);
              border-bottom: 3px solid #00bfff;
              display: inline-block;
              padding-bottom: 5px;
              margin: 0;
            ">
          Opti-<span style="color: #00bfff">Reserve</span>
        </h1>
      </div>

      <div class="mb-4 text-center">
        <h2 class="h4 text-white fw-bold mb-1">Forgot Password</h2>
        <p class="text-muted small mb-0">Verify your account using Email and Date of Birth</p>
      </div>

      <!-- Express + EJS Feedback Alerts -->
      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger mb-4">
          <%= error %>
        </div>
      <% } %>
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success mb-4">
          <%= success %>
        </div>
      <% } %>

      <form method="POST" action="/forgot-password">
        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" id="email" name="email" class="form-control"
            placeholder="Enter your registered email" required />
        </div>

        <div class="mb-4">
          <label for="dob" class="form-label">Date of Birth</label>
          <input type="date" id="dob" name="dob" class="form-control" required />
        </div>

        <div class="mb-4">
          <button type="submit" class="btn btn-primary w-100">
            Verify
          </button>
        </div>

        <div class="text-center text-muted small mt-4">
          <p class="mb-0">
            Remembered your password?
            <a href="<%= route('login.show') %>" class="auth-link">Login here</a>
          </p>
        </div>
      </form>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/assets/admin/libs/bundle.js"></script>
  <script src="/assets/admin/js/app.min.js"></script>
</body>

</html>
