            align-items: center;
            width: 100%;
        }

        .menu-toggle-btn i {
            color: #DBB778;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <%- include('./components/header') %>


        <!-- Main Content -->
        <main>
            <%- include(body) %>
        </main>

        <!-- Footer -->
        <%- include('./components/footer') %>

            <!-- JS Scripts -->
            <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/intlTelInput.min.js"></script>
            <script src="/assets/User/js/all.js"></script>

            <!-- Phone Input Script -->
            <script>
                $(document).ready(function () {
                    const defaultCountry = "ae";
                    const input = document.querySelector("#ContentPlaceHolder1_txtphone");
                    if (input) {
                        const iti = window.intlTelInput(input, {
                            utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js",
                            initialCountry: defaultCountry
                        });

                        function logSelectedCountry() {
                            const selectedDialCode = '+' + iti.getSelectedCountryData().dialCode;
                            $('.phone').val(selectedDialCode);
                        }

                        logSelectedCountry();
                        input.addEventListener('countrychange', logSelectedCountry);

                        $(document).on('keydown', '.phone', function (e) {
                            const inputValue = $('.phone').val();
                            if (inputValue === '+' + iti.getSelectedCountryData().dialCode && e.keyCode == 8) {
                                e.preventDefault();
                            }
                        });
                    }
                });
            </script>

            <!-- Mobile Font Adjustment -->
            <script>
                function removeFontSizeClassForMobile() {
                    if (window.innerWidth <= 768) {
                        document.querySelectorAll('.my_card_title.font-size').forEach(el => {
                            el.classList.remove('font-size');
                            el.classList.add('font-size-mobile');
                        });
                    }
                }
                removeFontSizeClassForMobile();
                window.addEventListener('resize', removeFontSizeClassForMobile);
            </script>

            <script async src="https://kit.fontawesome.com/a3fb55638a.js" crossorigin="anonymous"></script>

            <!-- Global SweetAlert Flash Handler -->
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const successes = <% - JSON.stringify(success) %>;
                    const errors = <% - JSON.stringify(error) %>;

                    if (successes.length > 0) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: successes[0],
                            confirmButtonColor: '#00bfff',
                            background: '#0f172a',
                            color: '#fff'
                        });
                    }

                    if (errors.length > 0) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: errors[0],
                            confirmButtonColor: '#d33',
                            background: '#0f172a',
                            color: '#fff'
                        });
                    }
                });
            </script>

</body>

</html>