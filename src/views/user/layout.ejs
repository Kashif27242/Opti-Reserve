    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="/assets/User/css/all.css">
    <link rel="stylesheet" href="/assets/User/slick/slick-theme.css">
    <link rel="stylesheet" href="/assets/User/css/360.css">
    <link rel="stylesheet" href="/assets/User/css/newTheme.css">
    <link rel="stylesheet" href="/assets/User/css/premium-ui.css">
    <link rel="stylesheet" href="/assets/User/css/custom.css">
    <link rel="stylesheet" href="/assets/User/css/owl.carousel.min.css">
