<div class="container my-5">

  <!-- Resource Name & Category -->
  <h1 class="mb-3 text-white text-center" style="font-size: 5rem;">
    <%= resource.name %>
  </h1>
  <% if (categoryName) { %>
    <p class="text-center text-white"><strong>Category:</strong>
      <%= categoryName %>
    </p>
    <% } %>

      <!-- Description -->
      <div class="mb-4 text-center text-white">
        <p class="lead">
          <%= resource.description || 'No description available.' %>
        </p>
      </div>

      <!-- Booking Form -->
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card p-4 shadow-lg border-0" style="border-radius: 15px; background: white;">
            <h3 class="mb-4 text-center text-primary fw-bold">Book This Resource</h3>

            <form id="bookingForm" action="/booking/request" method="POST">
              <input type="hidden" name="resourceId" value="<%= resource.id %>">

              <div class="mb-3">
                <label class="form-label fw-bold">Your Name</label>
                <input type="text" name="name" class="form-control form-control-lg" value="<%= user ? user.name : '' %>"
                  readonly>
                <div class="form-text">Logged in as <%= user ? user.email : 'Guest' %>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Select Date</label>
                <input type="date" name="bookingDate" id="bookingDate" class="form-control form-control-lg" required>
              </div>

              <!-- Improved Session Dropdown -->
              <div class="mb-4">
                <label class="form-label fw-bold">Select Session(s)</label>
                <select name="sessions[]" id="sessionSelect" class="form-select" multiple size="8"
                  style="min-height: 250px;" required>
                  <% if (typeof timeSlots !=='undefined' && timeSlots.length> 0) { %>
                    <% timeSlots.forEach(slot=> { %>
                      <option value="<%= slot.id %>" class="py-2"
                        data-base-text="<%= slot.label ? slot.label + ' (' + slot.startTime + ' - ' + slot.endTime + ')' : slot.startTime + ' - ' + slot.endTime %>">
                        <%= slot.label ? slot.label + ' (' + slot.startTime + ' - ' + slot.endTime + ')' :
                          slot.startTime + ' - ' + slot.endTime %>
                      </option>
                      <% }) %>
                        <% } else { %>
                          <option disabled>No time slots available</option>
                          <% } %>
                </select>
                <div class="form-text mt-2"><i class="bi bi-info-circle"></i> Hold <strong>Ctrl</strong>
                  (Windows) or <strong>⌘</strong> (Mac) to select multiple sessions.</div>
              </div>

              <div class="d-grid gap-2">
                <!-- Dual Purpose Button Group -->
                <button type="submit" id="submitBtn" class="btn btn-primary btn-lg">
                  <i class="bi bi-calendar-check me-2"></i> Submit Booking Request
                </button>

                <button type="button" id="waitlistBtn" class="btn btn-warning btn-lg d-none">
                  <i class="bi bi-hourglass-split me-2"></i> Join Waitlist
                </button>

                <a href="/user/resources" class="btn btn-outline-secondary">Back to Resources</a>
              </div>
            </form>
          </div>
        </div>
      </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const dateInput = document.getElementById('bookingDate');
    const select = document.getElementById('sessionSelect');
    const form = document.getElementById('bookingForm');
    const submitBtn = document.getElementById('submitBtn');
    const waitlistBtn = document.getElementById('waitlistBtn');
    const resourceId = document.querySelector('input[name="resourceId"]').value;

    function updateUIState() {
      const selectedOptions = Array.from(select.selectedOptions);
      const hasBooked = selectedOptions.some(opt => opt.dataset.booked === "true");

      if (hasBooked) {
        submitBtn.classList.add('d-none');
        waitlistBtn.classList.remove('d-none');
      } else {
        submitBtn.classList.remove('d-none');
        waitlistBtn.classList.add('d-none');
      }
    }

    if (dateInput) {
      const today = new Date().toISOString().split('T')[0];
      dateInput.setAttribute('min', today);

      dateInput.addEventListener("change", async function () {
        const date = this.value;
        if (!date) return;

        // Reset options
        Array.from(select.options).forEach(opt => {
          opt.disabled = false;
          opt.removeAttribute('data-booked');
          opt.classList.remove('text-danger', 'fw-bold');
          opt.text = opt.dataset.baseText;
        });

        try {
          const response = await fetch(`/api/booking/availability?resourceId=${resourceId}&date=${date}`);
          const data = await response.json();

          if (data.bookedSlotIds) {
            data.bookedSlotIds.forEach(slotId => {
              const option = select.querySelector(`option[value="${slotId}"]`);
              if (option) {
                option.dataset.booked = "true";
                option.disabled = true; // Strictly disable the option
                option.classList.add('text-muted', 'text-decoration-line-through');
                option.text = option.dataset.baseText + " (BOOKED)";
              }
            });
          }
        } catch (err) {
          console.error("Error fetching availability:", err);
        }
        updateUIState();
      });
    }

    select.addEventListener('change', updateUIState);

    waitlistBtn.addEventListener('click', function () {
      form.action = "/booking/waitlist";
      form.submit();
    });
  });
</script>

<style>
  .card {
    background: #fff !important;
  }

  .text-primary {
    color: #0d41eb !important;
  }
</style>