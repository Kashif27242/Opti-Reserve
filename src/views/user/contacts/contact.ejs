<div class="container text-white py-5">
    <div class="glass-panel p-5 my-4 mx-auto" style="max-width: 800px;">
        <h3 class="fw-bold mb-4 text-center text-gradient" style="font-size: 36px;">Contact Us</h3>
        <p class="text-center text-muted mb-5" style="font-size: 18px;">
            Have a question or need assistance? At Opti-reserve, we're here to help with all your event planning needs.
            Whether you want to book a service, inquire about our event packages, or need support with your upcoming event,
            our team is just a message away. Let us make your event planning experience effortless and enjoyable!
        </p>

    <% if (message && message.length > 0) { %>
        <div class="alert alert-success text-center mt-4">
            <%= message %>
        </div>
        <% } %>

            <% if (errors && errors.length) { %>
                <div class="alert alert-danger mt-4">
                    <ul>
                        <% errors.forEach(err=> { %>
                            <li>
                                <%= err %>
                            </li>
                            <% }) %>
                    </ul>
                </div>
                <% } %>

                        <form action="/contacts/store" id="myForm" method="post" class="mt-4">
                            <div class="row g-4">
                                <div class="col-md-6 mb-2">
                                    <label class="form-label text-muted small uppercase">First Name *</label>
                                    <input name="first_name" type="text" class="form-control form-control-lg" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label text-muted small uppercase">Last Name *</label>
                                    <input name="last_name" type="text" class="form-control form-control-lg" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label text-muted small uppercase">Email *</label>
                                    <input name="email" type="email" class="form-control form-control-lg" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label text-muted small uppercase">Mobile *</label>
                                    <input name="phone" type="tel" class="form-control form-control-lg" required>
                                </div>
                                <div class="col-md-12 mb-4">
                                    <label class="form-label text-muted small uppercase">Comments</label>
                                    <textarea name="comments" class="form-control form-control-lg" rows="4" required></textarea>
                                </div>
                            </div>

                            <div class="d-grid mt-5">
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold hover-lift">Send Message <i class="fa-solid fa-paper-plane ms-2"></i></button>
                            </div>
                        </form>
    </div>


</div>