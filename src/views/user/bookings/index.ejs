<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">My Bookings</h1>
        <a href="/user/resources" class="btn btn-primary">Book New Resource</a>
    </div>

    <% if (message && message.length> 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
            <% if (errors && errors.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= errors %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                    <div class="card shadow-sm border-0">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="py-3 px-4">Resource</th>
                                            <th class="py-3 px-4">Date</th>
                                            <th class="py-3 px-4">Time Slot</th>
                                            <th class="py-3 px-4">Status</th>
                                            <th class="py-3 px-4">Submitted On</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (bookings && bookings.length> 0) { %>
                                            <% bookings.forEach(booking=> { %>
                                                <tr>
                                                    <td class="py-3 px-4 fw-bold text-primary">
                                                        <%= booking.resource ? booking.resource.name
                                                            : 'Unknown Resource' %>
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <%= new Date(booking.bookingDate).toLocaleDateString(undefined,
                                                            { weekday: 'short' , year: 'numeric' , month: 'short' ,
                                                            day: 'numeric' }) %>
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <% if (booking.timeSlot) { %>
                                                            <span class="badge bg-light text-dark border">
                                                                <%= booking.timeSlot.startTime %> - <%=
                                                                        booking.timeSlot.endTime %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="text-muted">-</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <% if (booking.status==='confirmed' ) { %>
                                                            <span
                                                                class="badge bg-success rounded-pill px-3">Confirmed</span>
                                                            <% } else if (booking.status==='pending' ) { %>
                                                                <span
                                                                    class="badge bg-warning text-dark rounded-pill px-3">Pending</span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="badge bg-danger rounded-pill px-3">Rejected</span>
                                                                    <% } %>
                                                    </td>
                                                    <td class="py-3 px-4 text-muted small">
                                                        <%= new Date(booking.createdAt).toLocaleString() %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="5" class="text-center py-5 text-muted">
                                                                <i class="bi bi-calendar-x display-4 d-block mb-3"></i>
                                                                You haven't made any bookings yet.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
</div>