<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">My Bookings</h1>
        <a href="/user/resources" class="btn btn-primary">Book New Resource</a>
    </div>

    <% if (message && message.length> 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
            <% if (errors && errors.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= errors %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                    <div class="card glass-panel border-0 mt-4 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-dark table-hover mb-0" style="background: transparent;">
                                    <thead style="background: rgba(0,0,0,0.5); border-bottom: 2px solid rgba(0, 191, 255, 0.3);">
                                        <tr>
                                            <th class="py-3 px-4 text-white">Resource</th>
                                            <th class="py-3 px-4 text-white">Date</th>
                                            <th class="py-3 px-4 text-white">Time Slot</th>
                                            <th class="py-3 px-4 text-white">Status</th>
                                            <th class="py-3 px-4 text-white">Submitted On</th>
                                        </tr>
                                    </thead>
                                    <tbody style="border-top: none;">
                                        <% if (bookings && bookings.length> 0) { %>
                                            <% bookings.forEach(booking=> { %>
                                                <tr>
                                                    <td class="py-3 px-4 fw-bold text-primary">
                                                        <%= booking.resource ? booking.resource.name
                                                            : 'Unknown Resource' %>
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <%= new Date(booking.bookingDate).toLocaleDateString(undefined,
                                                            { weekday: 'short' , year: 'numeric' , month: 'short' ,
                                                            day: 'numeric' }) %>
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <% if (booking.timeSlot) { %>
                                                            <span class="badge bg-light text-dark border">
                                                                <%= booking.timeSlot.startTime %> - <%=
                                                                        booking.timeSlot.endTime %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="text-muted">-</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <% if (booking.status==='confirmed' ) { %>
                                                            <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.5);">Confirmed</span>
                                                            <% } else if (booking.status==='pending' ) { %>
                                                                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5);">Pending</span>
                                                                <% } else { %>
                                                                    <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.5);">Rejected</span>
                                                                    <% } %>
                                                    </td>
                                                    <td class="py-3 px-4 text-muted small">
                                                        <%= new Date(booking.createdAt).toLocaleString() %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="5" class="text-center py-5 text-muted">
                                                                <i class="bi bi-calendar-x display-4 d-block mb-3"></i>
                                                                You haven't made any bookings yet.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
</div>