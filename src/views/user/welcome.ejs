<div id="heroSlider" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
  <div class="carousel-inner">

    <% if (sliders && sliders.length> 0) { %>
      <% sliders.forEach((slider, index)=> { %>
        <div class="carousel-item <%= index === 0 ? 'active' : '' %> position-relative">
          <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(2,6,23,0.3) 0%, rgba(2,6,23,0.9) 100%); z-index: 1;"></div>
          <% if (slider.image.startsWith('http')) { %>
            <img src="<%= slider.image %>" class="d-block w-100 vh-100 object-fit-cover"
              alt="<%= slider.title || 'Slide' %>">
            <% } else { %>
              <img src="/uploads/sliders/<%= slider.image %>" class="d-block w-100 vh-100 object-fit-cover"
                alt="<%= slider.title || 'Slide' %>">
              <% } %>
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100" style="z-index: 2;">
                  <% if (slider.title) { %>
                    <h1 class="text-white fw-bold display-3 mb-3 fade-in-up" style="text-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                      <%= slider.title %>
                    </h1>
                    <% } %>
                      <% if (slider.description) { %>
                        <p class="lead text-light mb-4 fade-in-up" style="animation-delay: 0.2s; font-size: 1.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                          <%= slider.description %>
                        </p>
                        <% } %>
                        <a href="/user/resources" class="btn btn-primary btn-lg px-5 py-3 rounded-pill hover-lift fade-in-up mt-3 text-dark" style="animation-delay: 0.4s;">
                          Book a Service
                        </a>
                </div>
        </div>
        <% }) %>
          <% } else { %>
            <!-- Fallback static slide if no dynamic sliders -->
            <div class="carousel-item active position-relative">
              <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(2,6,23,0.3) 0%, rgba(2,6,23,0.9) 100%); z-index: 1;"></div>
              <img src="https://szabist-isb.edu.pk/wp-content/uploads/2020/05/356A7777-3.jpg"
                class="d-block w-100 vh-100 object-fit-cover" alt="Default Slide">
              <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100" style="z-index: 2;">
                <h1 class="text-white fw-bold display-3 mb-3 fade-in-up" style="text-shadow: 0 4px 15px rgba(0,0,0,0.5);">Welcome to Opti-Reserve</h1>
                <p class="lead text-light mb-4 fade-in-up" style="animation-delay: 0.2s; font-size: 1.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Smart Booking. Simple Experience.</p>
                <a href="/user/resources" class="btn btn-primary btn-lg px-5 py-3 rounded-pill hover-lift fade-in-up mt-3 text-dark" style="animation-delay: 0.4s;">
                  Book a Service
                </a>
              </div>
            </div>
            <% } %>

  </div>

  <!-- Navigation buttons -->
  <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev" style="z-index: 3;">
    <span class="carousel-control-prev-icon p-4 rounded-circle" style="background-color: rgba(0,0,0,0.5);"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next" style="z-index: 3;">
    <span class="carousel-control-next-icon p-4 rounded-circle" style="background-color: rgba(0,0,0,0.5);"></span>
  </button>
</div>

<br>
<br>
<br>
<br>
<br>
<br>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var myCarousel = document.querySelector('#heroSlider')
    var carousel = new bootstrap.Carousel(myCarousel, {
      interval: 4000,
      ride: 'carousel'
    })
  });
</script>