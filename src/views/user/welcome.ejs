<div id="heroSlider" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
  <div class="carousel-inner">

    <% if (sliders && sliders.length> 0) { %>
      <% sliders.forEach((slider, index)=> { %>
        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
          <% if (slider.image.startsWith('http')) { %>
            <img src="<%= slider.image %>" class="d-block w-100 vh-100 object-fit-cover"
              alt="<%= slider.title || 'Slide' %>">
            <% } else { %>
              <img src="/uploads/sliders/<%= slider.image %>" class="d-block w-100 vh-100 object-fit-cover"
                alt="<%= slider.title || 'Slide' %>">
              <% } %>
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                  <% if (slider.title) { %>
                    <h1 class="text-white fw-bold display-4">
                      <%= slider.title %>
                    </h1>
                    <% } %>
                      <% if (slider.description) { %>
                        <p class="lead text-light">
                          <%= slider.description %>
                        </p>
                        <% } %>
                </div>
        </div>
        <% }) %>
          <% } else { %>
            <!-- Fallback static slide if no dynamic sliders -->
            <div class="carousel-item active">
              <img src="https://szabist-isb.edu.pk/wp-content/uploads/2020/05/356A7777-3.jpg"
                class="d-block w-100 vh-100 object-fit-cover" alt="Default Slide">
              <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                <h1 class="text-white fw-bold display-4">Welcome to Opti-Reserve</h1>
                <p class="lead text-light">Smart Booking. Simple Experience.</p>
              </div>
            </div>
            <% } %>

  </div>

  <!-- Navigation buttons -->
  <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

<br>
<br>
<br>
<br>
<br>
<br>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var myCarousel = document.querySelector('#heroSlider')
    var carousel = new bootstrap.Carousel(myCarousel, {
      interval: 4000,
      ride: 'carousel'
    })
  });
</script>